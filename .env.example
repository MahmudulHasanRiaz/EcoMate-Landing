# Direct Postgres for drizzle-kit + seed (local/CI only, port 5432).
# Supabase dashboard → Connect → "Direct connection" tab:
#   postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres
# NOT the "Drizzle"/ORM tab (that is the port-6543 transaction pooler with user
# `postgres.REF`, which cannot run DDL migrations). Hyperdrive/the Worker uses
# the pooled URL separately via its binding — never put the pooler URL here.
DIRECT_URL="postgresql://postgres:password@db.REF.supabase.co:5432/postgres"
# Hyperdrive pooled string lives in the Cloudflare Dashboard binding, NOT here
# Worker secrets set via: npx wrangler secret put <NAME>
LICENSE_PORTAL_API_BASE_URL="https://license.ecomate.bd"
LICENSE_PORTAL_API_KEY="" # secret: npx wrangler secret put LICENSE_PORTAL_API_KEY
NEXT_PUBLIC_SITE_URL="https://ecomate.bd"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
AUTH_SECRET="" # openssl rand -base64 32
AUTH_TRUST_HOST="true" # allowlist our own hostnames; never a bare trustHost:true
TOTP_ENCRYPTION_KEY="" # openssl rand -base64 32; AES-GCM key for admin TOTP secrets (falls back to AUTH_SECRET if unset)
SETUP_TOKEN="" # one-time bootstrap, rotate/delete after first superadmin
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE="" # Events Manager test code, empty in prod
# Turnstile bot protection is a PAIR — both halves must come from the same widget
# registration (Cloudflare dashboard → Turnstile → Add widget for your domain):
#   SITE KEY (public): paste into wrangler.toml [vars] NEXT_PUBLIC_TURNSTILE_SITE_KEY
#     (top-level + each [env.*] you deploy). Empty = no widget rendered.
#   SECRET KEY (secret): paste as GitHub Secret TURNSTILE_SECRET_KEY — CI pushes it
#     to the Worker on every deploy. Empty = tokens not verified.
# Half-configured either way fails OPEN with a loud log (never blocks leads);
# both empty = protection off; both set = protection on.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
RESEND_API_KEY="" # future lead notifications, unused until wired
NOTIFY_FROM_EMAIL="" # Resend sender for new-lead sales notifications (Decision 7)
NOTIFY_TO_EMAIL="" # Resend recipient (sales inbox) for new-lead notifications (Decision 7)
CRON_SECRET="" # guards /api/cron/* routes
RETENTION_DAYS="180" # lead PII retention window (Task 16)
DIRECT_URL_TEST="" # throwaway test DB for integration tests; tests skip loudly if unset
# Presigned direct-to-R2 uploads: NOTHING to provision by hand. The deploy workflow
# mints the R2 API token itself (DEPLOYMENT.md §4b) from CLOUDFLARE_API_TOKEN +
# CLOUDFLARE_ACCOUNT_ID and stores all four values on the Worker. The names below
# exist only so local tooling knows what the Worker reads; never commit values.
# (Unset Worker values = sign endpoint 503s, admin uploader uses the legacy route.)
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="ecomate-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
